<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Enlace</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <link rel="stylesheet"
          href="~/css/depoimentos.css"
          asp-append-version="true" />

</head>

<body>


    <header class="navbar">

        <a class="brand"
           asp-controller="Home"
           asp-action="Index">

            Enlace

        </a>

        <nav class="nav-links">

            <a asp-controller="Home"
               asp-action="Index">

                Início

            </a>

            <a asp-controller="Sobre"
               asp-action="Sobre">

                Sobre nós

            </a>

            <a asp-controller="Servicos"
               asp-action="Servicos">

                Serviços

            </a>

            <a class="active"
               asp-controller="Depoimentos"
               asp-action="Depoimentos">

                Depoimentos

            </a>

        </nav>

    </header>


    

    <main>

        @RenderBody()

    </main>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>