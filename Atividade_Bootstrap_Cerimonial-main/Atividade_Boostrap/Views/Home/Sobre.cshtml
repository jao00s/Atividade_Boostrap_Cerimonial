@model EnlaceMVC.Models.SobreViewModel

@{
    ViewData["Title"] = "Sobre";
    Layout = "~/Views/Shared/EnlaceSobreLayout.cshtml";
}

<section class="hero-section" id="sobre">
    <img class="hero-image"
         src="@Model.ImagemHero"
         alt="Equipe de cerimonial em um evento" />

    <div class="hero-overlay"></div>

    <a class="quote-button"
   asp-controller="Orcamento"
   asp-action="Index">
    @Model.BotaoOrcamento
     </a>
</section>

<section class="about-section">
    <div class="about-title">
        <h1>@Model.Titulo</h1>
    </div>

    <div class="about-content">
        <div class="about-images">
            @foreach (var imagem in Model.Imagens)
            {
                <img src="@imagem" alt="Momento de uma cerimônia Enlace" />
            }
        </div>

        <div class="about-card">
            <p>@Model.Texto</p>
        </div>
    </div>
</section>
