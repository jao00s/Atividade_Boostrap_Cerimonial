@model EnlaceMVC.Models.ServicosViewModel

@{
    ViewData["Title"] = "Serviços";
    Layout = "~/Views/Shared/EnlaceLayout.cshtml";
}

<section class="hero-section" id="sobre">

    <img class="hero-image"
         src="https://images.unsplash.com/photo-1519225421980-715cb0215aed?auto=format&fit=crop&w=1600&q=85"
         alt="Casamento ao ar livre" />

    <div class="hero-overlay"></div>

    <a class="quote-button"
       asp-controller="Orcamento"
       asp-action="Index">
        @Model.BotaoOrcamento
    </a>

</section>


<section class="services-section" id="servicos">

    <h1 class="section-title">
        @Model.Titulo
    </h1>

    <div class="service-card">

        <div class="rose rose-left">
            🌹
        </div>

        <p>
            @Model.Texto
        </p>

        <div class="rose rose-right">
            🌹
        </div>

    </div>

</section>


<section class="depoimentos-section" id="depoimentos">

    <h2>Depoimentos</h2>

    <p>
        Em breve, histórias de casais que viveram esse momento com a gente.
    </p>

    <a asp-controller="Depoimentos"
       asp-action="Depoimentos"
       class="quote-button">
        Ver depoimentos
    </a>

</section>