<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Enlace</title>
    <link rel="stylesheet" href="~/css/depoimentos.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar">
        <a class="brand"
           asp-controller="Home"
           asp-action="Index">
            Enlace
        </a>

        <nav class="nav-links" aria-label="Navegação principal">
            <a asp-controller="Home" asp-action="Index">Sobre</a>

            <a asp-controller="Servicos" asp-action="Servicos">Serviços</a>

            <a class="active"
               asp-controller="Depoimentos"
               asp-action="Depoimentos">
                Depoimentos
            </a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
