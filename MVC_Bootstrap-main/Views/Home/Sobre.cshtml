@{
    ViewData["Title"] = "Sobre - Enlace Cerimonial";
}

<section class="page-hero mt-4">
    <img class="page-hero-image" src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1400&q=80" alt="Equipe Enlace Cerimonial celebrando" />
    <a class="btn btn-wine btn-lg page-hero-cta" asp-controller="Cerimonias" asp-action="Criar">Solicitar orçamento</a>
</section>

<section class="py-5 text-center">
    <h1 class="section-title mb-4">Sobre</h1>

    <div class="row justify-content-center mb-5">
        <div class="col-lg-8">
            <div class="note-card p-4 p-lg-5 text-start">
                <p class="mb-0">
                    A Enlace Cerimonial nasceu da paixão por transformar cerimônias em momentos
                    únicos e inesquecíveis. Com sensibilidade, profissionalismo e atenção a cada
                    detalhe, conduzimos seu grande dia com a emoção e a elegância que ele merece.
                </p>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h2 class="h5 text-start mb-3" style="color: var(--wine);">Nossa Essência</h2>

            <div class="team-scroll d-flex d-md-none gap-3 mb-2 pb-2">
                <img class="team-photo-sm rounded-4 shadow-sm" src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=600&q=80" alt="Organização dos detalhes da cerimônia" />
                <img class="team-photo-sm rounded-4 shadow-sm" src="https://images.unsplash.com/photo-1529636798458-92182e662485?auto=format&fit=crop&w=600&q=80" alt="Equipe Enlace Cerimonial" />
                <img class="team-photo-sm rounded-4 shadow-sm" src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=600&q=80" alt="Planejamento da cerimônia" />
            </div>

            <div class="row g-3 d-none d-md-flex">
                <div class="col-md-4">
                    <img class="img-fluid rounded-4 shadow-sm team-photo" src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=600&q=80" alt="Organização dos detalhes da cerimônia" />
                </div>
                <div class="col-md-4">
                    <img class="img-fluid rounded-4 shadow-sm team-photo" src="https://images.unsplash.com/photo-1529636798458-92182e662485?auto=format&fit=crop&w=600&q=80" alt="Equipe Enlace Cerimonial" />
                </div>
                <div class="col-md-4">
                    <img class="img-fluid rounded-4 shadow-sm team-photo" src="https://images.unsplash.com/photo-1542744173-8e7e53415bb0?auto=format&fit=crop&w=600&q=80" alt="Planejamento da cerimônia" />
                </div>
            </div>
        </div>
    </div>
</section>
