@{
    ViewData["Title"] = "Enclace - Cerimonial de casamentos";
}

<section class="hero py-5">
  <div class="container py-lg-4">
    <div class="row align-items-center g-4">
      <div class="col-lg-6 text-center text-lg-start">
        <p class="eyebrow mb-2">CERIMONIAL DE CASAMENTOS</p>
        <h1 class="display-5 fw-semibold mb-3">Cerimônias que encantam a sua história</h1>
        <p class="lead mb-4">Cuidamos de cada detalhe para que vocês vivam um dia leve, bonito e inesquecível.</p>
        <svg class="venn-graphic d-lg-none mx-auto mb-4" viewBox="0 0 200 120" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="80" cy="60" r="50" fill="none" stroke="#c79a2b" stroke-width="4" />
          <circle cx="120" cy="60" r="50" fill="none" stroke="#6a3ea1" stroke-width="4" />
        </svg>
        <a class="btn btn-wine btn-lg px-4" asp-controller="Cerimonias" asp-action="Criar">Agendar conversa</a>
      </div>
      <div class="col-lg-6 d-none d-lg-block">
        <img class="img-fluid rounded-4 shadow hero-image" src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1000&q=80" alt="Casal em cerimônia de casamento" />
      </div>
    </div>
  </div>
</section>

<section id="servicos" class="py-5">
  <div class="container">
    <div class="text-center mb-4"><p class="eyebrow mb-1">NOSSA EXPERIÊNCIA</p><h2 class="section-title">Nossos serviços</h2></div>
    <div class="row g-3 g-md-4">
      <div class="col-md-4"><article class="card service-card h-100 border-0 shadow-sm"><div class="card-body p-4"><div class="service-icon d-none d-md-block">♡</div><div class="d-flex justify-content-between align-items-center"><h3 class="h4 mb-0 mb-md-2">Cerimônia civil</h3><span class="service-dot dot-1 d-md-none" aria-hidden="true"></span></div><p class="mb-0 mt-2 mt-md-0">Orientação para cada etapa deste momento especial.</p></div></article></div>
      <div class="col-md-4"><article class="card service-card h-100 border-0 shadow-sm"><div class="card-body p-4"><div class="service-icon d-none d-md-block">✦</div><div class="d-flex justify-content-between align-items-center"><h3 class="h4 mb-0 mb-md-2">Mestre de cerimônias</h3><span class="service-dot dot-2 d-md-none" aria-hidden="true"></span></div><p class="mb-0 mt-2 mt-md-0">Celebração conduzida com sensibilidade e organização.</p></div></article></div>
      <div class="col-md-4"><article class="card service-card h-100 border-0 shadow-sm"><div class="card-body p-4"><div class="service-icon d-none d-md-block">⌁</div><div class="d-flex justify-content-between align-items-center"><h3 class="h4 mb-0 mb-md-2">Assessoria completa</h3><span class="service-dot dot-3 d-md-none" aria-hidden="true"></span></div><p class="mb-0 mt-2 mt-md-0">Planejamento para o casal aproveitar cada instante.</p></div></article></div>
    </div>
  </div>
</section>

<section id="sobre" class="py-5 bg-soft">
  <div class="container"><div class="row g-4 align-items-center">
    <div class="col-lg-6 order-lg-2"><img class="img-fluid rounded-4 shadow" src="https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=1000&q=80>" alt="Equipe celebrando casamento" /></div>
    <div class="col-lg-6 order-lg-1"><p class="eyebrow mb-2">SOBRE NÓS</p><h2 class="section-title">Detalhes pensados com afeto</h2><p>Transformamos sonhos em celebrações autênticas, com planejamento, acolhimento e atenção ao que torna cada casal único.</p><a class="link-wine" asp-controller="Cerimonias" asp-action="Index">Ver cerimônias cadastradas →</a></div>
  </div></div>
</section>