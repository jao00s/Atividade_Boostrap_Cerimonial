@{
    ViewData["Title"] = "Depoimentos - Enlace Cerimonial";

    var depoimentos = new[]
    {
        new { Foto = "https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=300&q=80", Casal = "Junior e Luciana", Cor = "accent-1" },
        new { Foto = "https://images.unsplash.com/photo-1529636798458-92182e662485?auto=format&fit=crop&w=300&q=80", Casal = "Tatiana e Luiz", Cor = "accent-2" },
        new { Foto = "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=300&q=80", Casal = "Roberto e Claudia", Cor = "accent-3" },
        new { Foto = "https://images.unsplash.com/photo-1511285560929-80b456fea0bc?auto=format&fit=crop&w=300&q=80", Casal = "Silvia e Antonio", Cor = "accent-4" },
    };
}

<section class="page-hero mt-4">
    <img class="page-hero-image" src="https://images.unsplash.com/photo-1520854221256-17451cc331bf?auto=format&fit=crop&w=1400&q=80" alt="Cerimônia de casamento ao entardecer" />
    <a class="btn btn-wine btn-lg page-hero-cta" asp-controller="Cerimonias" asp-action="Criar">Solicitar orçamento</a>
</section>

<section class="py-5 text-center">
    <h1 class="section-title mb-5">Depoimentos</h1>

    <div class="row g-3 g-md-4 justify-content-center">
        @foreach (var d in depoimentos)
        {
            <div class="col-12 col-md-3">
                <div class="testimonial-card d-flex d-md-block align-items-center gap-3 text-start text-md-center">
                    <img class="testimonial-avatar mb-md-3" src="@d.Foto" alt="Casal @d.Casal" />
                    <div>
                        <p class="fw-semibold mb-1">&quot;Equipe excelente e prestativa.&quot;</p>
                        <p class="fw-bold mb-0 testimonial-name @d.Cor">@d.Casal</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
