@{
    ViewData["Title"] = "Serviços - Enlace Cerimonial";
}

<section class="page-hero mt-4">
    <img class="page-hero-image" src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1400&q=80" alt="Casal se casando ao ar livre" />
    <a class="btn btn-wine btn-lg page-hero-cta" asp-controller="Cerimonias" asp-action="Criar">Solicitar orçamento</a>
</section>

<section class="py-5 text-center">
    <h1 class="section-title mb-4">Serviços</h1>
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="note-card p-4 p-lg-5 text-start">
                <p class="mb-0">
                    Na Enlace Cerimonial, transformamos momentos únicos em memórias inesquecíveis.
                    Nosso trabalho vai muito além da condução de uma cerimônia: cuidamos de cada
                    detalhe para que sua celebração reflita, de forma autêntica, a história e a
                    essência de quem você é.
                </p>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-4 gap-md-5 mt-4">
        <svg class="rose-icon" viewBox="0 0 64 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M32 8c10 0 16 8 12 16-3 6-11 8-12 8s-9-2-12-8c-4-8 2-16 12-16z" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="32" cy="20" r="6" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M32 32c0 30-10 34-10 50" fill="none" stroke="#7a9b76" stroke-width="2" />
            <path d="M22 60c-8 0-12 6-10 12" fill="none" stroke="#7a9b76" stroke-width="2" />
            <path d="M30 75c8-2 12 4 10 10" fill="none" stroke="#7a9b76" stroke-width="2" />
        </svg>
        <svg class="rose-icon" viewBox="0 0 64 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M32 8c10 0 16 8 12 16-3 6-11 8-12 8s-9-2-12-8c-4-8 2-16 12-16z" fill="none" stroke="currentColor" stroke-width="2" />
            <circle cx="32" cy="20" r="6" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M32 32c0 30-10 34-10 50" fill="none" stroke="#7a9b76" stroke-width="2" />
            <path d="M22 60c-8 0-12 6-10 12" fill="none" stroke="#7a9b76" stroke-width="2" />
            <path d="M30 75c8-2 12 4 10 10" fill="none" stroke="#7a9b76" stroke-width="2" />
        </svg>
    </div>
</section>
